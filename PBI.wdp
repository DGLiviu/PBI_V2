 code_elements :
  internal_properties : BwAAAAcAAACyo+AGPHs6tl+CMW8i1j+hisKclwORtfzp4tr+6B34gnEg+AegA2o6CeaiNwKFgQlNnqdA
  type_code : 0
  p_codes :
   -
     code : |1+
      //-------------------------------------------------------------------------------------------------------------------------------------------------------------------------
      //---Declaration CONSTANTES
      //-------------------------------------------------------------------------------------------------------------------------------------------------------------------------
      csNomFichierCommun est une chaîne									//Nom du fichier où sont stockées les informations communes (DevGlass)
      csNomApplication est une chaîne										//Nom de l'application
      csNomFicIniApplication est une chaîne								//Nom du fichier .ini de l'application
      
      //-------------------------------------------------------------------------------------------------------------------------------------------------------------------------
      //---INIT CONSTANTES
      //-------------------------------------------------------------------------------------------------------------------------------------------------------------------------
      csNomFichierCommun="DevGlass"
      csNomApplication="PBI"
      csNomFicIniApplication = csNomApplication + ".ini"
      
      //-------------------------------------------------------------------------------------------------------------------------------------------------------------------------
      //---Declaration Globales
      //-------------------------------------------------------------------------------------------------------------------------------------------------------------------------
      GLOBAL
      	gsCheminDossierWindev est une chaîne
      	gsCheminDossierCommunIni est une chaîne								//Nom du dossier .ini commun pour tous les fichiers ini
      	gsCheminDossierHFCommun est une chaîne								//Emplacement des fichiers HyperFile de DevGlass (communs aux applications WinDev)
      	gsCheminDossierHFApplication est une chaîne							//Emplacement des fichiers HyperFile specifiques a l'application
      	gsCheminDossierHF_DEVGLASS est une chaîne							//Emplacement des fichiers HyperFile de DevGlass de l'appli
      	gsCheminFichierCommunIni est une chaîne								//Emplacement du fichier ini commun 
      	gsCheminFichierIniApplication est une chaîne						//Emplacement du fichier ini de l'application
      		
      	//Variables Nouvelle gestion Connexion,Société,Utilisateur,Param
      	gTabConnexion est un tableau de stConnexion
      	gsNomConnexionHF_commun est une connexion
      	
      	gTabSociete est un tableau de stSociete
      	gSocietesSousTraitance est un tableau de stSociete
      	gTabParametre est un tableau de StParametre
      	gSociete est un stSociete
      	gSte est une stSociete dynamique 
      	gUtilisateurCourant est un stUtilisateur
      	
      	gMode			est un StParametre dynamique
      	gFraise			est un StParametre dynamique
      	gParam			est un StParametre dynamique
      	gPortLecture	est un StParametre dynamique
      	gRépertoire		est un StParametre dynamique
      	gFicTemp		est un StParametre dynamique
      	gFic			est un StParametre dynamique
      	gSonKO			est un StParametre dynamique
      	gSonInfo		est un StParametre dynamique
      	gSonOK			est un StParametre dynamique
      	gPortEcriture est un entier
      
      si pas EnModeService() ALORS
      	Lancer_version_secours()
      FIN
      
      init_societe_utilisateur_appli()
      
     type : 196608
   -
     code : |1+
      trace(gSociete.Num,gSociete.nom)
     type : 196622
   -
     code : |1-
      
     type : 196610
   -
     type : 196621
   -
     type : 196627
