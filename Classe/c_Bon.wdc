   -
     name : LectureFichier
     procedure_id : 1965186376873913130
     type_code : 12
     code : |1-
      PROCEDURE LectureFichier(xAnnée,xBon)
      
      :Année	= xAnnée
      :Bon	= xBon
      ret est une chaine
      
      nomFic est une chaine = "%1%2_%3.txt"
      nomFic = ChaîneConstruit(nomFic,gRépertoire.valeur+"\",:Année,Droite("00000"+:Bon,5))
      
      //:Epure = LectureEpure(objet)
      
      si fFichierExiste(nomFic) alors
      	txtFic est une chaine = fChargeTexte(nomFic)
      	uneLigne est une c_Ligne dynamique
      	valLigne est une chaine
      	pour toute chaine sc de txtFic séparée par rc
      		si sc <> "" alors
      			valLigne = Sansespace(ExtraitChaîne(sc,2,"/"))
      			
      			uneLigne = allouer une c_Ligne
      			uneLigne:Prod		= droite(ExtraitChaîne(sc,1,"/"),4)
      			uneLigne:Quantité	= gauche(valLigne,4)
      			pour i = 1 _a_ (taille(valLigne)-4)/5
      				uneLigne:tab_Cotes[i] = val(valLigne[5+((i-1)*5) sur 5])/10
      			FIN
      			TableauAjoute(:tabLigne,uneLigne)
      		FIn
      	FIN
      SINON
      	SI pas gMode.Valeur = "RR-SOFT" ALORS		
      		si pas :Epure alors
      			ret = "ERREUR : Le fichier n'existe pas : " + CheminRéseau(nomFic)
      		FIN
      	FIN
      FIN
      
      renvoyer ret
     type : 458752
